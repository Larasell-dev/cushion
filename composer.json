{
    "name": "larasell/form-drafts",
    "description": "Form draft persistence for Laravel: server-backed auto-save for Inertia forms.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Larasell\\FormDrafts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larasell\\FormDrafts\\Tests\\": "tests/",
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larasell\\FormDrafts\\FormDraftsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}